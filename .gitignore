# Dependencies
node_modules/
.pnp
.pnp.cjs
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Environment variables and secrets
# Never commit a real key: LLM credentials belong in the Convex deployment
# environment (`npx convex env set`), not in a file.
.env
.env.*
!.env.example

# Convex: local backend state, not source (convex/_generated IS committed)
.convex/
convex/*.zip

# Local data and logs
.data/
.logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/
playwright/.cache/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local databases
*.sqlite
*.sqlite3
*.db

# Temporary files
tmp/
temp/
.cache/

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
